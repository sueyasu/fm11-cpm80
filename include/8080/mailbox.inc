; Common FM-11 CP/M-80 mailbox ABI, independent of native CPU.
; Shared mailbox. Place the ten-byte communication block at the very top
; of the common CP/M RAM layout so lower memory remains available to CP/M.
BOOTDRV EQU     0FBF4H  ; logical boot drive (0=2D, 4=2HD, 8=HDD)
MBOX_BASE EQU     0FBF6H
MBOX_CMD EQU     MBOX_BASE+0
MBOX_STATUS EQU     MBOX_BASE+1
MBOX_DRIVE EQU     MBOX_BASE+2
MBOX_FLAGS EQU     MBOX_BASE+3
MBOX_DATA EQU     MBOX_FLAGS
MBOX_TRACK_H EQU     MBOX_BASE+4
MBOX_TRACK_L EQU     MBOX_BASE+5
MBOX_SECTOR_H EQU     MBOX_BASE+6
MBOX_SECTOR_L EQU     MBOX_BASE+7
MBOX_DMA_H EQU     MBOX_BASE+8
MBOX_DMA_L EQU     MBOX_BASE+9

MBCMD_NONE EQU     00H
MBCMD_READ EQU     01H
MBCMD_WRITE EQU     02H
MBCMD_WBOOT EQU     03H
MBCMD_CACHE_SYNC EQU     04H
MBCMD_CACHE_RESET EQU     05H
MBCMD_HDD_GEOM EQU     06H  ; reply TRACK=DSM (BE), SECTOR=OFF (BE)
MBCMD_LOCAL_CONST EQU     10H
MBCMD_LOCAL_CONIN EQU     11H
MBCMD_LOCAL_CONOUT EQU     12H
MBCMD_SERIAL_CONST EQU     13H
MBCMD_SERIAL_CONIN EQU     14H
MBCMD_SERIAL_CONOUT EQU     15H
MBCMD_SERIAL_LISTST EQU     16H
MBCMD_SERIAL_MIRROR EQU     17H

MBSTAT_OK EQU     00H
MBSTAT_ERROR EQU     01H
